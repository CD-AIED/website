---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/articles';

const articles = await getPublishedArticles();
---

<BaseLayout title="Articles" description="Notes, research updates, and articles from CD-AIED, newest first.">
  <header class="page-intro">
    <p class="label">Notes & updates</p>
    <h1>All articles</h1>
    <p>Ideas, working notes, and useful things collected over time.</p>
  </header>

  {articles.length > 0 ? (
    <ul class="article-grid" role="list">
      {articles.map((article) => <li><ArticleCard article={article} /></li>)}
    </ul>
  ) : (
    <section class="empty-state compact">
      <h2>No published articles yet.</h2>
      <p>Check back soon.</p>
    </section>
  )}
</BaseLayout>
