---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TeamCarousel from '../components/TeamCarousel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { group, sponsors, projects, publications } from '../data/group';
import { getResearchers } from '../lib/researchers';
import { getPublishedArticles } from '../lib/articles';
import { sitePath } from '../lib/paths';

const people = await getResearchers();
const articles = await getPublishedArticles();
const recentPublications = [...publications].sort((a, b) => b.year - a.year).slice(0, 5);
---
<BaseLayout>
  <section class="welcome" aria-labelledby="welcome-heading">
    <header>
      <p class="label">CD-AIED · A research group</p>
      <h1 id="welcome-heading">Research at the<br class="desktop-break" /> University of Bucharest.</h1>
      <p class="lead">{group.introduction}</p>
      <a class="text-link" href="#research">Explore our interests <span aria-hidden="true">↓</span></a>
    </header>
    <aside class="welcome-note" aria-label="Our outlook">
      <span class="note-mark" aria-hidden="true">↗</span>
      <h2>Room for new perspectives.</h2>
      <p>{group.outlook}</p>
      <a href="#team">Meet the people <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section id="research" class="section" aria-labelledby="research-heading">
    <header class="section-heading">
      <div><p class="label">What we’re curious about</p><h2 id="research-heading">Research interests</h2></div>
      {group.researchIsPlaceholder && <small class="sample-note">Sample topics · to be confirmed</small>}
    </header>
    <ul class="interest-list" role="list">
      {group.interests.map((interest, index) => (
        <li>
          <span class="interest-number" aria-hidden="true">0{index + 1}</span>
          <h3>{interest.title}</h3>
          <p>{interest.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <TeamCarousel people={people} />

  <div class="work-grid">
    <section id="projects" class="section" aria-labelledby="projects-heading">
      <header class="section-heading"><div><p class="label">What we’re working on</p><h2 id="projects-heading">Projects</h2></div></header>
      {projects.length ? (
        <ul class="work-list" role="list">
          {projects.map((project) => <li><h3>{project.url ? <a href={project.url}>{project.title}</a> : project.title}</h3><p>{project.description}</p></li>)}
        </ul>
      ) : <p class="muted">We’re getting started. Our projects will appear here as the work takes shape.</p>}
    </section>
    <section id="publications" class="section" aria-labelledby="publications-heading">
      <header class="section-heading"><div><p class="label">From the group</p><h2 id="publications-heading">Recent publications</h2></div></header>
      {recentPublications.length ? (
        <ol class="work-list" role="list">
          {recentPublications.map((publication) => (
            <li>
              <p class="label">{publication.venue} · {publication.year}</p>
              <h3><a href={publication.url}>{publication.title}</a></h3>
              <p>{publication.authors}</p>
              {publication.abstract && <details><summary>Abstract</summary><p>{publication.abstract}</p></details>}
            </li>
          ))}
        </ol>
      ) : <p class="muted">Papers and other research outputs will be collected here. More to share soon.</p>}
    </section>
  </div>

  <section id="sponsors" class="section sponsors" aria-labelledby="sponsors-heading">
    <header class="section-heading">
      <div><p class="label">Supporting the work</p><h2 id="sponsors-heading">Sponsors</h2></div>
      {sponsors.some((sponsor) => sponsor.placeholder) && <small class="sample-note">Example marks · not endorsements</small>}
    </header>
    <ul class="sponsor-list" role="list">
      {sponsors.map((sponsor) => {
        const Tag = sponsor.url ? 'a' : 'span';
        return <li>
          <Tag class:list={['sponsor', { 'sponsor-placeholder': sponsor.placeholder }]} href={sponsor.url} aria-label={sponsor.url ? sponsor.name : undefined}>
            <Image src={sponsor.logo} width={Math.min(sponsor.logo.width, 208)} densities={[1, 2]} alt={sponsor.placeholder ? '' : sponsor.name} loading="lazy" />
            {sponsor.placeholder && <span>{sponsor.name}</span>}
          </Tag>
        </li>;
      })}
    </ul>
    {!sponsors.length && <p class="muted">Sponsorship details will be added here.</p>}
  </section>

  {articles.length > 0 && (
    <section class="section" aria-labelledby="articles-heading">
      <header class="section-heading">
        <div><p class="label">Notes & updates</p><h2 id="articles-heading">From the notebook</h2></div>
        <a href={sitePath('/articles/')}>All articles <span aria-hidden="true">↗</span></a>
      </header>
      <ul class="article-grid" role="list">
        {articles.slice(0, 3).map((article) => <li><ArticleCard article={article} headingLevel="h3" /></li>)}
      </ul>
    </section>
  )}
</BaseLayout>
