---
import { Image } from 'astro:assets';
import AuthorList from './AuthorList.astro';
import { type Article, getReadingTime } from '../lib/articles';
import { getArticleAuthors } from '../lib/researchers';
import { sitePath } from '../lib/paths';

interface Props { article: Article; headingLevel?: 'h2' | 'h3' }
const { article, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt } = article.data;
const authors = await getArticleAuthors(article);
---
<article class="article-card">
  {cover && <Image class="card-cover" src={cover} alt={coverAlt ?? ''} widths={[480, 760]} sizes="(max-width: 600px) 100vw, 380px" loading="lazy" />}
  <header>
    <p class="meta"><time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time> · {getReadingTime(article.body)} min read</p>
    <Heading><a href={sitePath(`/articles/${article.id}/`)}>{title}</a></Heading>
    <p class="meta">By <AuthorList authors={authors} /></p>
  </header>
  <p>{description}</p>
  {tags.length > 0 && <ul class="tag-list" aria-label="Topics" role="list">{tags.map((tag) => <li>{tag}</li>)}</ul>}
</article>
