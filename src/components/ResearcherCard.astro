---
import { Image } from 'astro:assets';
import { type Researcher, fullName, researcherPhoto } from '../lib/researchers';
import { sitePath } from '../lib/paths';

interface Props { person: Researcher; headingLevel?: 'h2' | 'h3' }
const { person, headingLevel: Heading = 'h3' } = Astro.props;
const { username, role, affiliation, summary, placeholder } = person.data;
---
<article class="person-card">
  <header>
    <div class="person-heading">
      <div class="portrait">
        <Image src={researcherPhoto(username)} alt="" widths={[96, 192]} sizes="3.25rem" loading="lazy" />
      </div>
      <div>
        {placeholder && <small class="label">Sample profile</small>}
        <Heading><a href={sitePath(`/researchers/${username}/`)}>{fullName(person)}</a></Heading>
      </div>
    </div>
    {role && <p class="person-role">{role}</p>}
    {affiliation && <p class="muted">{affiliation}</p>}
  </header>
  {summary && <p>{summary}</p>}
</article>
