---
import { SITE_TITLE } from '../consts';
import { sitePath } from '../lib/paths';
const pathname = Astro.url.pathname;
const links = [
  { label: 'About', href: sitePath('/'), current: pathname === sitePath('/') },
  { label: 'Research', href: sitePath('/#research') },
  { label: 'Team', href: sitePath('/#team'), current: pathname.startsWith(sitePath('/team/')) || pathname.startsWith(sitePath('/researchers/')) },
];
---
<header class="site-header">
  <a class="brand" href={sitePath('/')} aria-label={`${SITE_TITLE} home`}>
    <img src={sitePath('/logo-header.svg?v=1')} alt="" width="828" height="943" />
  </a>
  <nav aria-label="Main navigation">
    <ul role="list">{links.map((link) => <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>)}</ul>
  </nav>
</header>
